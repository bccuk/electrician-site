---
import '../styles/global.css';
import { site } from '../data/site';
import Nav from '../components/Nav.astro';
import StatusBanner from '../components/StatusBanner.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ?? site.seo.title;
const pageDescription = description ?? site.seo.description;

// Canonical URL = site + base. Works for both GitHub Pages (with base)
// and a future custom domain (where base is "/").
const canonicalUrl = Astro.site
  ? new URL(import.meta.env.BASE_URL, Astro.site).href.replace(/\/?$/, '/')
  : undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/+/g, '/')} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}/apple-touch-icon.png`.replace(/\/+/g, '/')} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}/manifest.webmanifest`.replace(/\/+/g, '/')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="The Cut Co." />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content="en_GB" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <!-- Theme color matches the cream background -->
    <meta name="theme-color" content="#faf7f2" />

    <!-- Fonts: Playfair Display (display serif) + Inter (UI sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- LocalBusiness JSON-LD for SEO -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BarberShop',
        name: site.name,
        description: site.description,
        url: canonicalUrl,
        telephone: site.contact.phone,
        email: site.contact.email,
        address: {
          '@type': 'PostalAddress',
          streetAddress: site.contact.address.line1,
          addressLocality: site.contact.address.city,
          postalCode: site.contact.address.postcode,
          addressCountry: 'GB',
        },
        priceRange: '££',
        openingHoursSpecification: site.hours
          .filter((h) => h.hours !== 'Closed')
          .map((h) => ({
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: h.day,
            opens: h.hours.split(' – ')[0],
            closes: h.hours.split(' – ')[1],
          })),
      })}
    />
  </head>
  <body class="min-h-screen bg-cream text-ink antialiased">
    <StatusBanner />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
