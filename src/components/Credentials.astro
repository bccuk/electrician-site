---
// Trust strip — text-based UK electrician credentials. Displayed as small
// shield/check-icon badges in a horizontal strip just below the hero.
// Uses representational text + icons rather than real organisation logos to
// stay clean of trademark issues for a sample site.

const credentials = [
  { label: 'NICEIC Approved', icon: 'shield' },
  { label: 'Part P Compliant', icon: 'check' },
  { label: 'Public Liability £5m', icon: 'shield' },
  { label: '12-Month Guarantee', icon: 'check' },
] as const;
---

<section
  aria-label="Credentials"
  class="bg-cream border-y border-ink/10"
>
  <div class="container-page py-6 md:py-8">
    <ul class="grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-4 max-w-4xl mx-auto">
      {credentials.map((c) => (
        <li class="flex items-center gap-3">
          <span class="w-9 h-9 grid place-items-center rounded-full bg-brass/10 text-brass shrink-0">
            {c.icon === 'shield' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="M9 12l2 2 4-4" />
              </svg>
            )}
            {c.icon === 'check' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            )}
          </span>
          <div class="min-w-0">
            <p class="text-[0.65rem] uppercase tracking-[0.18em] text-muted">Certified</p>
            <p class="text-sm font-semibold text-ink leading-tight">{c.label}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
