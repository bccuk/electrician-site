---
import { site } from '../data/site';
---

<section id="testimonials" class="section-pad bg-cream">
  <div class="container-page">
    <div class="text-center max-w-2xl mx-auto">
      <p class="eyebrow">What people say</p>
      <h2 class="mt-4 font-display text-4xl md:text-5xl lg:text-6xl leading-[1.05] text-ink">
        {site.rating.score} stars,<br class="sm:hidden" />
        <span class="text-brass"> {site.rating.count} reviews.</span>
      </h2>

      <!-- Stars row -->
      <div class="mt-6 flex items-center justify-center gap-1 text-brass">
        {
          Array.from({ length: 5 }).map((_, i) => (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill={i < Math.round(site.rating.score) ? 'currentColor' : 'none'}
              stroke="currentColor"
              stroke-width="1.5"
              class="w-5 h-5"
            >
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
          ))
        }
        <span class="ml-3 text-sm text-muted">on {site.rating.source}</span>
      </div>
    </div>

    <div class="mt-14 md:mt-20 grid md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
      {
        site.testimonials.map((t, i) => (
          <figure
            class:list={[
              'relative bg-cream-dark rounded-sm p-7 md:p-8 border border-ink/5',
              i === 0 && 'lg:col-span-2 lg:row-span-1',
            ]}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-7 h-7 text-brass/70"
            >
              <path d="M7 7h4v4H8c0 2.2 1.8 4 4 4v3c-3.9 0-7-3.1-7-7V7zm9 0h4v4h-3c0 2.2 1.8 4 4 4v3c-3.9 0-7-3.1-7-7V7z" />
            </svg>
            <blockquote class="mt-4 font-display text-xl md:text-2xl leading-snug text-ink">
              {t.quote}
            </blockquote>
            <figcaption class="mt-5 flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-muted">
              <span class="w-6 h-px bg-brass" />
              {t.author}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
