---
import { site } from '../data/site';

const { request, services } = site;
const fields = request.fields;
---

<form
  class="bg-cream/[0.04] border border-cream/10 rounded-sm p-7 md:p-9 space-y-5"
  action={request.formspreeEndpoint}
  method="POST"
>
  <input type="hidden" name="_subject" value={request.submitSubject} />

  <div class="grid sm:grid-cols-2 gap-5">
    <label class="block">
      <span class="text-xs uppercase tracking-[0.18em] text-cream/60">Your name</span>
      <input
        type="text"
        name="name"
        required
        autocomplete="name"
        class="mt-2 w-full bg-transparent border-b border-cream/20 focus:border-brass-light outline-none py-2 text-cream placeholder:text-cream/30"
        placeholder="First and last"
      />
    </label>
    <label class="block">
      <span class="text-xs uppercase tracking-[0.18em] text-cream/60">Phone</span>
      <input
        type="tel"
        name="phone"
        required
        autocomplete="tel"
        class="mt-2 w-full bg-transparent border-b border-cream/20 focus:border-brass-light outline-none py-2 text-cream placeholder:text-cream/30"
        placeholder="07…"
      />
    </label>
  </div>

  {fields.service && (
    <label class="block">
      <span class="text-xs uppercase tracking-[0.18em] text-cream/60">Which service?</span>
      <select
        name="service"
        required
        class="mt-2 w-full bg-ink border-b border-cream/20 focus:border-brass-light outline-none py-2 text-cream"
      >
        <option value="" class="bg-ink">Pick a service…</option>
        {services.map((s) => (
          <option value={s.name} class="bg-ink">
            {s.name} — £{s.price}
          </option>
        ))}
        <option value="Other" class="bg-ink">Something else</option>
      </select>
    </label>
  )}

  {fields.urgency && (
    <fieldset class="block">
      <legend class="text-xs uppercase tracking-[0.18em] text-cream/60">How soon?</legend>
      <div class="mt-3 flex flex-wrap gap-2">
        {[
          'Emergency (today)',
          'This week',
          'Next 2–4 weeks',
          'Whenever',
        ].map((opt) => (
          <label class="cursor-pointer">
            <input type="radio" name="urgency" value={opt} class="peer sr-only" required />
            <span class="inline-block px-3.5 py-2 rounded-full border border-cream/20 text-sm text-cream/80 peer-checked:bg-brass peer-checked:border-brass peer-checked:text-cream transition-colors">
              {opt}
            </span>
          </label>
        ))}
      </div>
    </fieldset>
  )}

  {fields.preferredTime && (
    <label class="block">
      <span class="text-xs uppercase tracking-[0.18em] text-cream/60">When suits you?</span>
      <input
        type="text"
        name="preferred_time"
        class="mt-2 w-full bg-transparent border-b border-cream/20 focus:border-brass-light outline-none py-2 text-cream placeholder:text-cream/30"
        placeholder="e.g. Saturday afternoon, or any day after 4pm"
      />
    </label>
  )}

  {fields.address && (
    <label class="block">
      <span class="text-xs uppercase tracking-[0.18em] text-cream/60">Job address / postcode</span>
      <input
        type="text"
        name="address"
        autocomplete="street-address"
        class="mt-2 w-full bg-transparent border-b border-cream/20 focus:border-brass-light outline-none py-2 text-cream placeholder:text-cream/30"
        placeholder="House / road / postcode"
      />
    </label>
  )}

  {fields.notes && (
    <label class="block">
      <span class="text-xs uppercase tracking-[0.18em] text-cream/60">Anything else?</span>
      <textarea
        name="notes"
        rows="3"
        class="mt-2 w-full bg-transparent border-b border-cream/20 focus:border-brass-light outline-none py-2 text-cream placeholder:text-cream/30 resize-none"
        placeholder="Optional — special requests, who to ask for, etc."
      ></textarea>
    </label>
  )}

  <!-- Honeypot for bots -->
  <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

  <button type="submit" class="btn-primary w-full justify-center mt-2">
    {request.submitLabel}
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="w-4 h-4"
    >
      <line x1="22" y1="2" x2="11" y2="13" />
      <polygon points="22 2 15 22 11 13 2 9 22 2" />
    </svg>
  </button>

  <p class="text-xs text-cream/40 text-center">
    We aim to reply within a couple of hours during business hours.
  </p>
</form>
