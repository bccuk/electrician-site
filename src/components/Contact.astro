---
import { site } from '../data/site';
import RequestForm from './RequestForm.astro';
---

<section id="book" class="section-pad bg-ink text-cream grain">
  <div class="container-page">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16 max-w-5xl mx-auto">
      <!-- Left: heading + quick contact paths -->
      <div class="md:col-span-5">
        <p class="eyebrow">{site.request.eyebrow}</p>
        <h2 class="mt-4 font-display text-4xl md:text-5xl lg:text-6xl leading-[1.05]">
          {site.request.heading}
        </h2>
        <p class="mt-6 text-base text-cream/70 leading-relaxed">
          {site.request.intro}
        </p>

        <!-- Quick contact paths -->
        <div class="mt-8 space-y-3">
          <a
            href={site.contact.phoneHref}
            class="flex items-center gap-4 p-4 rounded-sm bg-cream/[0.04] border border-cream/10 hover:border-brass transition-colors group"
          >
            <span class="w-10 h-10 grid place-items-center rounded-full bg-cream text-ink shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M2 5.88 5.88 2a1 1 0 0 1 1.41 0l2.83 2.83a1 1 0 0 1 0 1.41L8.12 7.25a13.05 13.05 0 0 0 8.63 8.63l1-2a1 1 0 0 1 1.41 0l2.83 2.83a1 1 0 0 1 0 1.41L18.12 22a1 1 0 0 1-1.06.23A19.93 19.93 0 0 1 2 6.94 1 1 0 0 1 2 5.88z"/></svg>
            </span>
            <div class="flex-1">
              <p class="text-[0.65rem] uppercase tracking-[0.22em] text-cream/50">Or call us directly</p>
              <p class="font-display text-lg group-hover:text-brass-light transition-colors">
                {site.contact.phone}
              </p>
            </div>
          </a>

          <a
            href={site.contact.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-sm bg-cream/[0.04] border border-cream/10 hover:border-brass transition-colors group"
          >
            <span class="w-10 h-10 grid place-items-center rounded-full bg-cream text-ink shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.198-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/>
              </svg>
            </span>
            <div class="flex-1">
              <p class="text-[0.65rem] uppercase tracking-[0.22em] text-cream/50">Or message on WhatsApp</p>
              <p class="font-display text-lg group-hover:text-brass-light transition-colors">
                {site.contact.whatsapp}
              </p>
            </div>
          </a>

          <a
            href={site.contact.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-sm bg-cream/[0.04] border border-cream/10 hover:border-brass transition-colors group"
          >
            <span class="w-10 h-10 grid place-items-center rounded-full bg-cream text-ink shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s0 3.6-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.6 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.6 2.2 15.2 2.2 12s0-3.6.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.4 2.21 8.8 2.2 12 2.2zm0 4.86a4.94 4.94 0 1 0 0 9.88 4.94 4.94 0 0 0 0-9.88zm0 8.14a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm6.3-8.34a1.15 1.15 0 1 0-2.3 0 1.15 1.15 0 0 0 2.3 0z"/></svg>
            </span>
            <div class="flex-1">
              <p class="text-[0.65rem] uppercase tracking-[0.22em] text-cream/50">Or DM on Instagram</p>
              <p class="font-display text-lg group-hover:text-brass-light transition-colors">
                {site.contact.instagram}
              </p>
            </div>
          </a>
        </div>
      </div>

      <!-- Right: request form -->
      <div class="md:col-span-7">
        <RequestForm />
      </div>
    </div>
  </div>
</section>
