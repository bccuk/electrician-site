---
import { site } from '../data/site';
---

<section id="about" class="section-pad bg-cream">
  <div class="container-page">
    <div class="grid md:grid-cols-12 gap-12 md:gap-16 items-start">
      <div class="md:col-span-7">
        <p class="eyebrow">{site.about.eyebrow}</p>
        <h2 class="mt-4 font-display text-4xl md:text-5xl lg:text-6xl leading-[1.05] text-ink">
          {site.about.heading}
        </h2>

        <div class="mt-8 space-y-5 text-lg text-muted leading-relaxed max-w-2xl">
          {site.about.body.map((p) => <p>{p}</p>)}
        </div>

        <ul class="mt-10 space-y-3">
          {
            site.about.bullets.map((bullet) => (
              <li class="flex items-start gap-3 text-ink">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-brass shrink-0" />
                <span class="text-base">{bullet}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Sidecard / pull-quote -->
      <aside class="md:col-span-5">
        <div class="relative bg-ink text-cream rounded-sm p-8 md:p-10 grain">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-10 h-10 text-brass-light"
          >
            <path d="M7 7h4v4H8c0 2.2 1.8 4 4 4v3c-3.9 0-7-3.1-7-7V7zm9 0h4v4h-3c0 2.2 1.8 4 4 4v3c-3.9 0-7-3.1-7-7V7z"/>
          </svg>

          <p class="mt-6 font-display text-2xl md:text-3xl leading-snug">
            We don't rush a haircut. You sit down, we listen, then we get it right.
          </p>

          <div class="mt-8 pt-6 border-t border-cream/10">
            <p class="text-sm font-medium text-cream">The {site.shortName} team</p>
            <p class="text-xs text-cream/50 mt-1">
              On the High Street since {site.established}
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
