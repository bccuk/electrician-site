---
import { site } from '../data/site';

const today = new Date().toLocaleDateString('en-GB', { weekday: 'long' });
---

<section id="visit" class="section-pad bg-ink text-cream grain">
  <div class="container-page relative">
    <div class="grid md:grid-cols-12 gap-12 md:gap-16">
      <!-- Hours -->
      <div class="md:col-span-5">
        <p class="eyebrow">Open seven days</p>
        <h2 class="mt-4 font-display text-4xl md:text-5xl lg:text-6xl leading-[1.05]">
          When &amp; where.
        </h2>

        <ul class="mt-10 divide-y divide-cream/10">
          {
            site.hours.map((row) => {
              const isToday = row.day === today;
              const isClosed = row.hours === 'Closed';
              return (
                <li
                  class:list={[
                    'flex items-baseline justify-between py-4 transition-colors',
                    isToday && 'text-brass-light',
                  ]}
                >
                  <span class="flex items-center gap-3 text-base">
                    {row.day}
                    {isToday && (
                      <span class="text-[0.6rem] uppercase tracking-[0.2em] bg-brass text-cream px-2 py-0.5 rounded-full">
                        Today
                      </span>
                    )}
                  </span>
                  <span
                    class:list={[
                      'tabular-nums text-base',
                      isClosed && !isToday && 'text-cream/40',
                    ]}
                  >
                    {row.hours}
                  </span>
                </li>
              );
            })
          }
        </ul>

        <div class="mt-10 p-5 bg-cream/[0.04] border border-cream/10 rounded-sm">
          <p class="text-sm text-cream/80">
            <span class="font-semibold text-brass-light">Walk-ins welcome</span>
            — but Saturdays book up early. Call ahead to skip the wait.
          </p>
          <a
            href={site.contact.phoneHref}
            class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-brass-light hover:text-brass transition-colors"
          >
            {site.contact.phone}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>

      <!-- Map + address -->
      <div class="md:col-span-7">
        <div class="relative aspect-[4/3] md:aspect-[5/4] overflow-hidden rounded-sm border border-cream/10">
          <iframe
            src={site.contact.googleMapsEmbed}
            title={`Map of ${site.name}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="absolute inset-0 w-full h-full filter grayscale contrast-110"
          ></iframe>
        </div>

        <div class="mt-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div>
            <p class="text-xs uppercase tracking-[0.22em] text-brass mb-2">
              Find us
            </p>
            <p class="text-lg font-display">
              {site.contact.address.line1}
            </p>
            <p class="text-sm text-cream/70">
              {site.contact.address.city} · {site.contact.address.postcode}
            </p>
          </div>
          <a
            href={site.contact.googleMapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline text-cream text-sm !py-2.5 !px-5"
          >
            Open in Maps
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
