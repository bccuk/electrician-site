---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-cream">
  <div class="container-page py-14 md:py-20">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-display text-3xl md:text-4xl font-semibold leading-none">
          The <span class="text-brass">Cut</span> Co.
        </p>
        <p class="mt-3 text-[0.65rem] uppercase tracking-[0.22em] text-cream/60">
          Barber · {site.location}
        </p>
        <p class="mt-5 text-sm text-cream/60">
          {site.location}'s traditional barbershop. Est. {site.established}.
        </p>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.22em] text-brass mb-3">Visit</p>
        <p class="text-sm text-cream/80">{site.contact.address.line1}</p>
        <p class="text-sm text-cream/80">
          {site.contact.address.city} · {site.contact.address.postcode}
        </p>
        <a
          href={site.contact.phoneHref}
          class="block mt-3 text-sm text-cream/80 hover:text-brass transition-colors"
        >
          {site.contact.phone}
        </a>
        <a
          href={`mailto:${site.contact.email}`}
          class="block text-sm text-cream/80 hover:text-brass transition-colors"
        >
          {site.contact.email}
        </a>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.22em] text-brass mb-3">Follow</p>
        <div class="flex gap-3">
          <a
            href={site.contact.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-10 h-10 grid place-items-center rounded-full border border-cream/20 hover:border-brass hover:text-brass transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s0 3.6-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.6 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.6 2.2 15.2 2.2 12s0-3.6.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.4 2.21 8.8 2.2 12 2.2zm0 1.8c-3.15 0-3.5 0-4.74.07-1.07.05-1.65.23-2.04.38-.51.2-.88.44-1.27.83-.39.39-.63.76-.83 1.27-.15.39-.33.97-.38 2.04C2.66 9.83 2.65 10.18 2.65 12s0 2.17.07 3.41c.05 1.07.23 1.65.38 2.04.2.51.44.88.83 1.27.39.39.76.63 1.27.83.39.15.97.33 2.04.38 1.24.06 1.59.07 4.74.07s3.5 0 4.74-.07c1.07-.05 1.65-.23 2.04-.38.51-.2.88-.44 1.27-.83.39-.39.63-.76.83-1.27.15-.39.33-.97.38-2.04.06-1.24.07-1.59.07-4.74s0-3.5-.07-4.74c-.05-1.07-.23-1.65-.38-2.04a3.4 3.4 0 0 0-.83-1.27 3.4 3.4 0 0 0-1.27-.83c-.39-.15-.97-.33-2.04-.38C15.5 4.01 15.15 4 12 4zm0 3.06a4.94 4.94 0 1 1 0 9.88 4.94 4.94 0 0 1 0-9.88zm0 8.14a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zm6.3-8.34a1.15 1.15 0 1 1-2.3 0 1.15 1.15 0 0 1 2.3 0z"/></svg>
          </a>
          <a
            href={site.contact.facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="w-10 h-10 grid place-items-center rounded-full border border-cream/20 hover:border-brass hover:text-brass transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M13.5 21v-7.5h2.5l.5-3h-3v-2c0-.9.3-1.5 1.6-1.5H17V4.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4 1.5-4 4.2v2.3H8v3h2.5V21h3z"/></svg>
          </a>
          <a
            href={site.contact.phoneHref}
            aria-label="Phone"
            class="w-10 h-10 grid place-items-center rounded-full border border-cream/20 hover:border-brass hover:text-brass transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M2 5.88 5.88 2a1 1 0 0 1 1.41 0l2.83 2.83a1 1 0 0 1 0 1.41L8.12 7.25a13.05 13.05 0 0 0 8.63 8.63l1-2a1 1 0 0 1 1.41 0l2.83 2.83a1 1 0 0 1 0 1.41L18.12 22a1 1 0 0 1-1.06.23A19.93 19.93 0 0 1 2 6.94 1 1 0 0 1 2 5.88z"/></svg>
          </a>
        </div>

        <p class="mt-5 text-xs text-cream/50">
          {site.contact.instagram} — daily fresh cuts.
        </p>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-cream/10 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <p class="text-xs text-cream/50">
        © {year} {site.name}. All rights reserved.
      </p>
      <p class="text-xs text-cream/40">
        Site by <a href="https://bytecodeconsulting.com" class="hover:text-brass transition-colors">Bytecode Consulting Limited</a>
        <span class="mx-1.5 text-cream/20">·</span>
        <a href="https://website.bytecodeconsulting.com" target="_blank" rel="noopener" class="hover:text-brass transition-colors">For shop owners</a>
      </p>
    </div>
  </div>
</footer>
