---
import { site } from '../data/site';

const links = [
  { label: 'Services', href: '#services' },
  { label: 'Gallery', href: '#gallery' },
  { label: 'About', href: '#about' },
  { label: 'Visit', href: '#visit' },
];
---

<header
  class="sticky top-0 z-50 backdrop-blur-md bg-cream/85 border-b border-ink/5"
>
  <div class="container-page flex items-center justify-between h-16 md:h-20">
    <a href="#top" class="flex items-baseline gap-2.5 group">
      <span class="font-display text-xl md:text-2xl font-semibold tracking-tight text-ink">
        The <span class="text-brass">Cut</span> Co.
      </span>
      <span class="hidden sm:inline text-[0.65rem] uppercase tracking-[0.22em] text-muted">
        {site.location}
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-ink/80 hover:text-brass transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={site.contact.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="WhatsApp"
        class="w-9 h-9 grid place-items-center rounded-full border border-ink/15 text-ink hover:bg-ink hover:text-cream transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.198-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/>
        </svg>
      </a>
      <a href={site.contact.phoneHref} class="btn-primary !py-2 !px-5 text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
          <path d="M2.003 5.884 5.882 2.005a1 1 0 0 1 1.414 0l2.828 2.829a1 1 0 0 1 0 1.414L8.124 7.249a13.05 13.05 0 0 0 8.627 8.627l1.001-2.001a1 1 0 0 1 1.414 0l2.829 2.829a1 1 0 0 1 0 1.414l-3.879 3.879a1 1 0 0 1-1.06.226A19.928 19.928 0 0 1 2 6.944a1 1 0 0 1 .003-1.06z"/>
        </svg>
        <span class="hidden sm:inline">Book Now</span>
        <span class="sm:hidden">Call</span>
      </a>
    </div>
  </div>
</header>
